<Project Sdk="Microsoft.NET.Sdk">
  <!-- Minimal command-line checker used by scripts/test-all.* for the cross-language check. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>verify_cli</AssemblyName>
    <RootNamespace>LicenseSmith.Examples</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../LicenseSmith.csproj" />
  </ItemGroup>
</Project>
